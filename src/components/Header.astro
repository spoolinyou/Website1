---
/*
 * Primary navigation: 6 items + persistent Donate button.
 * Disclosure-pattern dropdowns (button + expanded state), keyboard operable.
 * Donate stays visible and becomes sticky-bottom on small screens.
 */
const nav = [
  { label: 'Home', href: '/' },
  {
    label: 'About',
    href: '/about',
    children: [
      { label: 'Our story', href: '/about/our-story' },
      { label: 'Board of directors', href: '/about/board' },
      { label: 'In the news', href: '/about/news' },
      { label: 'Contact', href: '/about/contact' },
    ],
  },
  {
    label: 'Programs',
    href: '/programs',
    children: [
      { label: 'Programs overview', href: '/programs' },
      { label: 'Homicides & cold case review', href: '/programs/homicides' },
      { label: 'Outreach & advocacy', href: '/programs/outreach-advocacy' },
      { label: 'Missing persons', href: '/programs/missing-persons' },
      { label: 'Education & reform', href: '/programs/education-reform' },
      { label: 'The Missing Link project', href: '/programs/the-missing-link' },
    ],
  },
  {
    label: 'Get Help',
    href: '/get-help',
    children: [
      { label: 'For families & friends', href: '/get-help/families' },
      { label: 'For law enforcement', href: '/get-help/law-enforcement' },
      { label: 'Submit an anonymous tip', href: '/get-help/submit-a-tip' },
      { label: 'Resources & hotlines', href: '/get-help/resources' },
    ],
  },
  {
    label: 'Get Involved',
    href: '/get-involved',
    children: [
      { label: 'Volunteer', href: '/get-involved/volunteer' },
      { label: 'Events', href: '/get-involved/events' },
      { label: 'Request a speaker', href: '/get-involved/request-a-speaker' },
      { label: 'Legislative advocacy', href: '/get-involved/legislative-advocacy' },
    ],
  },
  { label: 'Blog', href: '/blog' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Silver Lining of Hope — home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">
        <strong>Silver Lining of Hope</strong>
        <small>Investigative advocacy, free of charge</small>
      </span>
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="visually-hidden">Menu</span>
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22" fill="none">
        <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) =>
            item.children ? (
              <li class="has-menu">
                <button
                  class="nav-link nav-menu-btn"
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="none">
                    <path d="M2 3.5 5 6.5 8 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <ul class="submenu">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={currentPath === child.href ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  class="nav-link"
                  href={item.href}
                  aria-current={currentPath === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
        <li class="nav-donate">
          <a class="btn btn--primary" href="/donate">Donate</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.nav-toggle');
  const navEl = header?.querySelector('.site-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    navEl?.classList.toggle('is-open', !open);
  });

  const menuButtons = header?.querySelectorAll('.nav-menu-btn') ?? [];
  const closeAll = () => {
    menuButtons.forEach((b) => {
      b.setAttribute('aria-expanded', 'false');
      b.parentElement?.classList.remove('is-open');
    });
  };

  menuButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeAll();
      if (!open) {
        btn.setAttribute('aria-expanded', 'true');
        btn.parentElement?.classList.add('is-open');
      }
    });
  });

  document.addEventListener('click', (e) => {
    if (header && !header.contains(e.target as Node)) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>

<style>
  .site-header {
    background: var(--color-ink-deep);
    border-bottom: 1px solid var(--color-ink-soft);
    position: relative;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-paper);
    min-height: var(--tap);
  }

  /* Brand mark: a dawn horizon in miniature */
  .brand-mark {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 88%, var(--color-gold) 0 22%, transparent 40%),
      linear-gradient(to bottom, var(--color-ink) 0 62%, var(--color-silver) 62% 65%, var(--color-gold) 65% 68%, var(--color-ink-soft) 68%);
    border: 1px solid var(--color-silver-dim);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-text strong {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: var(--text-md);
    letter-spacing: 0.01em;
  }

  .brand-text small {
    font-size: var(--text-xs);
    color: var(--color-silver-dim);
    letter-spacing: 0.04em;
  }

  .nav-toggle {
    display: none;
    min-width: var(--tap);
    min-height: var(--tap);
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1.5px solid var(--color-silver-dim);
    border-radius: var(--radius-sm);
    color: var(--color-paper);
    cursor: pointer;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    padding: 0 var(--space-3);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-base);
    font-weight: 550;
    color: var(--color-silver);
    text-decoration: none;
    cursor: pointer;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-paper);
    background: var(--color-ink-soft);
  }

  .nav-link[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--color-gold);
  }

  .has-menu {
    position: relative;
  }

  .submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 16rem;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    background: var(--color-paper-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card-hover);
    padding: var(--space-2);
  }

  .has-menu.is-open .submenu {
    display: flex;
  }

  .submenu a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-base);
  }

  .submenu a:hover,
  .submenu a[aria-current='page'] {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .nav-donate {
    margin-left: var(--space-3);
  }

  @media (max-width: 63.99em) {
    .nav-toggle {
      display: inline-flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-ink-deep);
      border-bottom: 1px solid var(--color-ink-soft);
      padding: var(--space-4);
      max-height: calc(100vh - 80px);
      overflow-y: auto;
    }

    .site-nav.is-open {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
    }

    .nav-link {
      width: 100%;
      justify-content: space-between;
    }

    .submenu {
      position: static;
      box-shadow: none;
      background: var(--color-ink);
      border-color: var(--color-ink-soft);
    }

    .submenu a {
      color: var(--color-silver);
    }

    .submenu a:hover,
    .submenu a[aria-current='page'] {
      background: var(--color-ink-soft);
      color: var(--color-paper);
    }

    /* Donate stays reachable: sticky at the bottom of the mobile viewport */
    .nav-donate {
      margin: var(--space-3) 0 0;
    }

    .nav-donate .btn {
      width: 100%;
    }
  }
</style>
