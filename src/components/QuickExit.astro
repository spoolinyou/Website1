---
/*
 * Quick Exit / Safety Exit — standard on DV-adjacent sites.
 * Instantly replaces the current page with a neutral site and attempts to
 * scrub this page from the tab's history. Persistent and clearly visible.
 * ESC pressed twice within 1.5s also triggers it.
 */
---

<a
  href="https://www.google.com/search?q=weather"
  id="quick-exit"
  class="quick-exit"
  title="Leave this site immediately"
>
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
    <path d="M6 3H3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h3M10 11l3-3-3-3M13 8H6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  Quick exit
</a>

<script>
  const exit = () => {
    // Replace history entry so "back" doesn't return here, then leave.
    window.location.replace('https://www.google.com/search?q=weather');
  };
  document.getElementById('quick-exit')?.addEventListener('click', (e) => {
    e.preventDefault();
    exit();
  });
  let lastEsc = 0;
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const now = Date.now();
      if (now - lastEsc < 1500) exit();
      lastEsc = now;
    }
  });
</script>

<style>
  .quick-exit {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 150;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: 0 var(--space-4);
    background: var(--color-ink-deep);
    color: var(--color-paper);
    border: 1.5px solid var(--color-silver-dim);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 650;
    text-decoration: none;
    box-shadow: var(--shadow-card-hover);
  }

  .quick-exit:hover {
    background: var(--color-paper);
    color: var(--color-ink-deep);
  }

  @media print {
    .quick-exit {
      display: none;
    }
  }
</style>
