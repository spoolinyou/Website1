---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <hr class="lining" aria-hidden="true" />

    <div class="footer-grid">
      <div class="footer-mission">
        <p class="footer-brand">Silver Lining of Hope, Inc</p>
        <p>
          Free investigative research and advocacy for families of missing
          persons, unsolved homicides, unidentified persons, and survivors of
          domestic violence — and a partner resource for law enforcement.
        </p>
        <p class="footer-legal">
          A 501(c)(3) nonprofit organization · EIN 39-2169099 · Indiana, USA
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="footer-heading">Explore</h2>
        <ul>
          <li><a href="/about/our-story">Our story</a></li>
          <li><a href="/programs">Programs</a></li>
          <li><a href="/programs/the-missing-link">The Missing Link</a></li>
          <li><a href="/get-help">Get help</a></li>
          <li><a href="/get-involved">Get involved</a></li>
          <li><a href="/donate">Donate</a></li>
          <li><a href="/terms">Terms &amp; privacy</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="footer-heading">Crisis resources</h2>
        <ul>
          <li>
            <a href="tel:911">Emergency: call 911</a>
          </li>
          <li>
            <a href="tel:18007997233">National DV Hotline: 1-800-799-7233</a>
          </li>
          <li>
            <a href="tel:988">Suicide &amp; Crisis Lifeline: 988</a>
          </li>
          <li>
            <a href="https://namus.nij.ojp.gov/" rel="noopener">NamUs</a>
          </li>
          <li>
            <a href="https://www.missingkids.org/" rel="noopener">NCMEC</a>
          </li>
          <li>
            <a href="https://charleyproject.org/" rel="noopener">The Charley Project</a>
          </li>
        </ul>
        <p class="footer-safety">
          <strong>Internet safety:</strong> if someone may be monitoring your
          device, use the Quick exit button and consider browsing from a safer
          device. <a href="/get-help/resources#internet-safety">Learn more</a>.
        </p>
      </div>
    </div>

    <p class="footer-copy">
      © {year} Silver Lining of Hope, Inc. In memory of Leslie "Hope" Houston.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink-deep);
    color: var(--color-silver);
    padding-block: var(--space-6) var(--space-7);
    font-size: var(--text-base);
  }

  .site-footer a {
    color: var(--color-silver);
  }

  .site-footer a:hover {
    color: var(--color-paper);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
    margin-top: var(--space-5);
  }

  @media (min-width: 48em) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1.4fr;
      gap: var(--space-7);
    }
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-paper);
    margin-bottom: var(--space-3);
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer li {
    margin-bottom: var(--space-2);
  }

  .footer-legal {
    font-size: var(--text-sm);
    color: var(--color-silver-dim);
  }

  .footer-safety {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-silver-dim);
    max-width: 34ch;
  }

  .footer-copy {
    margin-top: var(--space-7);
    font-size: var(--text-sm);
    color: var(--color-silver-dim);
  }
</style>
