---
import PageLayout from '../../layouts/PageLayout.astro';

const pillars = [
  {
    letter: 'H',
    name: 'Homicides & cold case review',
    text: 'Investigative research and case review for unsolved, stalled, and hidden homicides — including deaths wrongly ruled accidental or undetermined.',
    href: '/programs/homicides',
  },
  {
    letter: 'O',
    name: 'Outreach & advocacy',
    text: 'Direct, personal support for families and survivors: navigating agencies, attending meetings and hearings, and making sure they are heard.',
    href: '/programs/outreach-advocacy',
  },
  {
    letter: 'P',
    name: 'Missing persons',
    text: 'Research, records requests, data cross-referencing, and public awareness for missing person cases in Indiana and surrounding states.',
    href: '/programs/missing-persons',
  },
  {
    letter: 'E',
    name: 'Education & reform',
    text: 'Community education, training, and legislative advocacy — including Dom & Davion\'s Law and Hailey\'s Law — to protect victims and fix system gaps.',
    href: '/programs/education-reform',
  },
];
---

<PageLayout
  title="Our Programs — The Pillars of HOPE | Silver Lining of Hope"
  description="Our work is organized into four pillars of HOPE: Homicides, Outreach & advocacy, Persons missing, and Education & reform. All services are free."
  heading="Programs: the four pillars of HOPE"
  intro="Everything we do is free for families and law enforcement, and every program belongs to one of four pillars."
  crumbs={[{ label: 'Programs', href: '/programs' }]}
>
  <div class="container section">
    <div class="grid-2">
      {
        pillars.map((p) => (
          <article class="card">
            <span class="pillar-letter" aria-hidden="true">{p.letter}</span>
            <h2>{p.name}</h2>
            <p>{p.text}</p>
            <a class="card-link" href={p.href}>Explore this pillar<span class="visually-hidden">: {p.name}</span></a>
          </article>
        ))
      }
    </div>

    <section class="tml-callout section--dark">
      <p class="eyebrow">Flagship project</p>
      <h2>The Missing Link</h2>
      <p>
        Our project to compile every available record on Indiana's 1,000+
        missing persons into one clean, cross-referenced, searchable public
        directory — expanding to Ohio, Illinois, Michigan, and Kentucky.
      </p>
      <a class="btn btn--primary" href="/programs/the-missing-link">About The Missing Link</a>
    </section>
  </div>

  <style>
    .tml-callout {
      margin-top: var(--space-7);
      border-radius: var(--radius-lg);
      padding: var(--space-7);
    }

    .tml-callout h2 {
      color: var(--color-paper);
    }

    .tml-callout p {
      max-width: 60ch;
    }
  </style>
</PageLayout>
