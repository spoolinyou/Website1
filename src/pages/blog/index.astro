---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<PageLayout
  title="Blog — Case Updates & Advocacy News | Silver Lining of Hope"
  description="Updates from Silver Lining of Hope: The Missing Link project, plain-language guides for families, advocacy news, and our story."
  heading="Blog"
  intro="Project updates, plain-language guides, and the occasional hard-won lesson."
  crumbs={[{ label: 'Blog', href: '/blog' }]}
>
  <div class="container section">
    <div class="grid-3">
      {
        posts.map((post) => (
          <article class="card">
            <p class="post-meta">
              <span class="post-tag">{post.data.category}</span>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {fmt(post.data.date)}
              </time>
            </p>
            <h2 class="post-title">
              <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </article>
        ))
      }
    </div>
  </div>

  <style>
    .post-meta {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      font-size: var(--text-sm);
      color: var(--color-text-soft);
    }

    .post-tag {
      font-weight: 650;
      color: var(--color-gold-deep);
    }

    .post-title {
      font-size: var(--text-lg);
      line-height: var(--leading-snug);
    }

    .post-title a {
      color: var(--color-ink);
      text-decoration: none;
    }

    .post-title a:hover {
      text-decoration: underline;
      text-decoration-color: var(--color-gold);
    }
  </style>
</PageLayout>
